OPENAI_API_KEY=
ORACLE_MODEL=gpt-5.6
JUDGE_MODEL=gpt-5.6

# OpenAI execution pool. Oracle can route and fail over across all enabled tiers
# using the same OPENAI_API_KEY.
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_SOL_ENABLED=true
OPENAI_TERRA_ENABLED=true
OPENAI_LUNA_ENABLED=true

# Starting priors. Learned performance increasingly overrides these assumptions.
OPENAI_SOL_QUALITY_SCORE=0.96
OPENAI_SOL_SPEED_SCORE=0.72
OPENAI_SOL_COST_SCORE=0.35
OPENAI_TERRA_QUALITY_SCORE=0.90
OPENAI_TERRA_SPEED_SCORE=0.84
OPENAI_TERRA_COST_SCORE=0.72
OPENAI_LUNA_QUALITY_SCORE=0.82
OPENAI_LUNA_SPEED_SCORE=0.96
OPENAI_LUNA_COST_SCORE=0.98

# Optional additional execution providers. A provider is only enabled when both
# its API key and model name are present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_STRENGTHS=writing,research,coding,general

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_STRENGTHS=research,general,coding,business

# Routing policy: quality | balanced | cost
ROUTING_POLICY=balanced

ANTHROPIC_QUALITY_SCORE=0.90
ANTHROPIC_SPEED_SCORE=0.68
ANTHROPIC_COST_SCORE=0.50
GEMINI_QUALITY_SCORE=0.87
GEMINI_SPEED_SCORE=0.82
GEMINI_COST_SCORE=0.70

# Execution resilience. Auto-routed requests can try the next-ranked configured
# model when a provider errors, times out, or still fails QA after repair.
PROVIDER_TIMEOUT_MS=45000
MAX_FAILOVER_MODELS=3

# Developer API keys. Format: id:secret,id2:secret2
# These secure /v1/oracle and /v1/usage. Do not commit real secrets.
ORACLE_API_KEYS=

# Monthly execution quota used when a key has no explicit override.
ORACLE_API_DEFAULT_QUOTA=500
# Optional per-key overrides. Format: keyId=limit,keyId2=limit
ORACLE_API_QUOTAS=

# Optional explicit cost overrides for models whose pricing Oracle does not know.
ORACLE_OPENAI_INPUT_USD_PER_M=
ORACLE_OPENAI_OUTPUT_USD_PER_M=
ORACLE_ANTHROPIC_INPUT_USD_PER_M=
ORACLE_ANTHROPIC_OUTPUT_USD_PER_M=
ORACLE_GEMINI_INPUT_USD_PER_M=
ORACLE_GEMINI_OUTPUT_USD_PER_M=

# Optional Postgres persistence. Without DATABASE_URL Oracle still works,
# but learned route performance resets on restart.
DATABASE_URL=
PGSSLMODE=require

PORT=3000

# Optional live market discovery for Revenue missions. Configure one.
# Brave is preferred when both are present.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Owner-only dashboard/API access for /sales.html and /api/sales/*.
ORACLE_ADMIN_TOKEN=

# Autonomous sales campaigns are enabled by default once a campaign exists.
# Set false for a global kill switch. Each campaign also has pause/resume,
# cadence and daily-run caps.
SALES_FORCE_ENABLED=true

# Optional approved outreach connector. Oracle sends signed JSON to this URL
# only for campaigns explicitly created with automatic outreach authorized.
SALES_OUTREACH_WEBHOOK_URL=
SALES_OUTREACH_WEBHOOK_SECRET=


# Native Resend sales channel. Oracle uses Resend when these are configured.
# RESEND_FROM must use a sender/domain verified in Resend. RESEND_REPLY_TO can
# use the Resend-provided inbound address for initial testing.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Required sender identity for automated commercial outreach. Oracle will not
# auto-send through Resend without these values and appends them to each email.
SALES_SENDER_BUSINESS_NAME=
SALES_SENDER_POSTAL_ADDRESS=

# Legacy/generic signed webhook connector remains supported as a fallback.
# Inbound replies from a custom connector must POST signed JSON to
# /api/sales/inbound using this HMAC secret.
SALES_INBOUND_WEBHOOK_SECRET=


# Native Gmail sales channel. This does not reuse ChatGPT's Gmail OAuth token.
# Use a Google App Password in Render; never commit it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Oracle Stack


# Preferred no-domain Gmail transport. Oracle POSTs HTTPS to a Google Apps
# Script web app that is authorized against the owner's Gmail account.
GMAIL_BRIDGE_URL=
GMAIL_BRIDGE_SECRET=
