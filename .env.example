OPENAI_API_KEY=
ORACLE_MODEL=gpt-5.6
AGENT_MODEL=gpt-5.6
JUDGE_MODEL=gpt-5.6

# Optional additional execution providers. A provider is only enabled when both
# its API key and model name are present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_STRENGTHS=writing,research,coding,general

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_STRENGTHS=research,general,coding,business

# Routing policy: quality | balanced | cost
ROUTING_POLICY=balanced

# Optional starting priors used before Oracle has enough real execution data.
OPENAI_QUALITY_SCORE=0.92
OPENAI_SPEED_SCORE=0.72
OPENAI_COST_SCORE=0.45
ANTHROPIC_QUALITY_SCORE=0.90
ANTHROPIC_SPEED_SCORE=0.68
ANTHROPIC_COST_SCORE=0.50
GEMINI_QUALITY_SCORE=0.87
GEMINI_SPEED_SCORE=0.82
GEMINI_COST_SCORE=0.70

PORT=3000
